<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClipNest.App.ViewModels"
        xmlns:controls="using:ClipNest.App.Controls"
        xmlns:models="using:ClipNest.Core.Models"
        xmlns:theme="using:ClipNest.App.Theme"
        xmlns:views="using:ClipNest.App.Views"
        x:Class="ClipNest.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ClipNest"
        Icon="/Assets/app.ico"
        Width="1440" Height="900"
        MinWidth="1080" MinHeight="640"
        TransparencyLevelHint="AcrylicBlur, Mica, Blur"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        FontFamily="{DynamicResource Font.UI}">

  <Window.Styles>
    <!-- 列表项默认带内边距，会与自绘行叠出双重缩进，这里统一清空。 -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- 侧栏行中导航项、文件夹与标签共用 32px 高度与 10px 圆角，保证左栏只有一种节奏。 -->
    <Style Selector="Button.nav">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Nav}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

    <!-- 行底色统一由内容里的 Border 自绘，避开 Fluent 模板的状态层。 -->
    <Style Selector="Border.rowFill">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="Button.nav:pointerover Border.rowFill,
                    Button.tagRow:pointerover Border.rowFill">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
    </Style>
    <Style Selector="Button.nav:pressed Border.rowFill,
                    Button.tagRow:pressed Border.rowFill">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Active}" />
    </Style>
    <Style Selector="Button.nav.active Border.rowFill">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
    </Style>

    <Style Selector="Border.folderRow">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.folderRow">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
    </Style>
    <!-- 悬停时文字与图标和导航项一样提亮到主文本色。 -->
    <Style Selector="ListBoxItem:pointerover TextBlock.folderName">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover controls|StrokeIcon.folderIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.folderRow">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
    </Style>
    <Style Selector="ListBoxItem:selected TextBlock.folderName">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="ListBoxItem:selected controls|StrokeIcon.folderIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Bright}" />
    </Style>

    <!-- 侧栏图标跟随行的前景色，选中态由 .active 单独提亮。 -->
    <Style Selector="Button.nav.active controls|StrokeIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Bright}" />
    </Style>
    <Style Selector="TextBlock.folderCount">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:pointerover TextBlock.folderCount">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:selected TextBlock.folderCount">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="StackPanel.folderActions">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="ListBoxItem:pointerover StackPanel.folderActions">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="ListBoxItem:selected StackPanel.folderActions">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <Style Selector="Button.tagRow">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Tag}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.tagRow:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="Button.tagRow:pointerover controls|StrokeIcon">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

    <!-- 详情页操作药丸使用内缩圆角高光，避免出现整块方形色块。 -->
    <Style Selector="Button.inspectorAction">
      <Setter Property="Margin" Value="4" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Control}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(1.0)" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
          <BrushTransition Property="Foreground" Duration="0:0:0.12" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"
                                         Easing="QuadraticEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.inspectorAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="Button.inspectorAction:pressed">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Active}" />
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>

    <!-- 详情栏分组卡，轻底板配发丝边，把松散属性与概览信息收拢成清晰层次。 -->
    <Style Selector="Border.inspectorCard">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,11" />
    </Style>

  </Window.Styles>

  <Grid x:Name="RootLayout" ClipToBounds="True">

    <!-- 环境层为当前图片的模糊投影，透过整窗玻璃可见。 -->
    <Image Source="{Binding EnvironmentBitmap}" Stretch="UniformToFill"
           RenderOptions.BitmapInterpolationMode="HighQuality"
           Margin="-60" Opacity="0.72" />
    <Border Background="{DynamicResource Brush.Overlay.Scrim}" />
    <Border Background="{DynamicResource Brush.Overlay.Ambient}" />

    <!-- 外壳铺满窗口，圆角交给系统窗口外框，内部卡片各自悬浮。 -->
    <Border Background="{DynamicResource Brush.Surface.Shell}" ClipToBounds="True">
      <Grid ColumnDefinitions="236,*,Auto">

        <!-- 侧栏从窗口顶部贯通到底，品牌区兼作窗口拖动区。 -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,44">

          <StackPanel Grid.Row="0" PointerPressed="TitleBar_PointerPressed">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,20,16,16">
              <Image Width="24" Height="24" VerticalAlignment="Center"
                     RenderOptions.BitmapInterpolationMode="HighQuality"
                     Source="avares://ClipNest.App/Assets/app-icon.png" />
              <TextBlock Text="ClipNest" Classes="heading" VerticalAlignment="Center" />
              <Border Width="1" Height="11" Background="{DynamicResource Brush.Border.Strong}"
                      VerticalAlignment="Center" Margin="2,0,0,0" />
              <TextBlock Text="{DynamicResource Str.Brand.Library}" Classes="micro" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>

          <!-- 缺少 VC++ 运行库时只提醒，不阻止浏览与整理。 -->
          <Border Grid.Row="1" IsVisible="{Binding HasRuntimeWarning}"
                  Background="{DynamicResource Brush.State.WarningSubtle}"
                  BorderBrush="{DynamicResource Brush.State.Warning}"
                  BorderThickness="1" CornerRadius="10"
                  Margin="10,0,10,8" Padding="10,8">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <controls:StrokeIcon Data="{StaticResource Icon.Warning}" Width="13" Height="13"
                                     Thickness="1.6"
                                     Foreground="{DynamicResource Brush.State.Warning}"
                                     VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource Str.Runtime.MissingTitle}" FontSize="{DynamicResource FontSize.Caption}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.State.Warning}"
                           VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding RuntimeWarning}" FontSize="{DynamicResource FontSize.Micro}" TextWrapping="Wrap"
                         LineHeight="{DynamicResource LineHeight.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" />
              <Button Classes="ghost" Content="{DynamicResource Str.Runtime.OpenDownload}" FontSize="{DynamicResource FontSize.Micro}"
                      HorizontalAlignment="Left" Click="OpenVcRuntimeDownload_Click" />
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalContentAlignment="Stretch">
            <StackPanel Margin="10,4,12,16" HorizontalAlignment="Stretch">

              <TextBlock Text="{DynamicResource Str.Nav.Section.Library}" Classes="section" Margin="10,0,0,6" />

              <StackPanel Spacing="0">
                <Button Classes="nav" Classes.active="{Binding IsAllSelected}"
                        Theme="{StaticResource SidebarRowButton}"
                        Command="{Binding ShowAllCommand}">
                  <Border Classes="rowFill">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <controls:StrokeIcon Data="{StaticResource Icon.Photo}" Width="16" Height="16" Thickness="1.6"
                                           VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{DynamicResource Str.Nav.AllImages}" Margin="10,0,8,0" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding TotalCount}" Classes="number"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </Button>

                <Button Classes="nav" Classes.active="{Binding IsUntaggedSelected}"
                        Theme="{StaticResource SidebarRowButton}"
                        Command="{Binding ShowUntaggedCommand}">
                  <Border Classes="rowFill">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <controls:StrokeIcon Classes="navIcon" Data="{StaticResource Icon.Hash}"
                                           Width="14" Height="14" Thickness="1.6"
                                           VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{DynamicResource Str.Nav.Untagged}" Margin="10,0,8,0" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </Button>
              </StackPanel>

              <Grid ColumnDefinitions="*,Auto" Margin="10,20,8,8">
                <TextBlock Text="{DynamicResource Str.Nav.Section.Folders}" Classes="section" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="icon" Width="22" Height="22"
                        Click="AddFolder_Click" ToolTip.Tip="{DynamicResource Str.Nav.ImportFolderTip}">
                  <controls:StrokeIcon Data="{StaticResource Icon.Plus}" Width="12" Height="12" Thickness="1.7" />
                </Button>
              </Grid>

              <ListBox Classes="plain" ItemsSource="{Binding Folders}"
                       HorizontalAlignment="Stretch"
                       ItemContainerTheme="{StaticResource FolderItemTheme}"
                       SelectedItem="{Binding SelectedFolder, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:Folder">
                    <Border Classes="folderRow" CornerRadius="10" Padding="10,0" Height="32"
                            ContextRequested="FolderRow_ContextRequested">
                      <Grid ColumnDefinitions="Auto,*,54">
                        <controls:StrokeIcon Classes="folderIcon" Data="{StaticResource Icon.Folder}"
                                             Width="16" Height="16" Thickness="1.6"
                                             Foreground="{DynamicResource Brush.Text.Tertiary}"
                                             VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="folderName" Text="{Binding Name}"
                                   Margin="8,0,8,0" FontSize="{DynamicResource FontSize.Nav}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Grid Grid.Column="2" Height="24" VerticalAlignment="Center">
                          <TextBlock Classes="folderCount" Text="{Binding AssetCount}"
                                     HorizontalAlignment="Right" VerticalAlignment="Center"
                                     FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                          <StackPanel Classes="folderActions" Orientation="Horizontal"
                                      Spacing="0" HorizontalAlignment="Right"
                                      VerticalAlignment="Center">
                            <Button Classes="icon" Width="24" Height="24"
                                    Click="RefreshFolder_Click" Tag="{Binding}"
                                    ToolTip.Tip="{DynamicResource Str.Nav.RefreshFolderTip}">
                              <controls:StrokeIcon Data="{StaticResource Icon.Refresh}" Width="12" Height="12" />
                            </Button>
                            <Button Classes="icon danger" Width="24" Height="24"
                                    Click="RemoveFolder_Click" Tag="{Binding}"
                                    ToolTip.Tip="{DynamicResource Str.Nav.RemoveFolderTip}">
                              <controls:StrokeIcon Data="{StaticResource Icon.Close}" Width="12" Height="12" Thickness="1.6" />
                            </Button>
                          </StackPanel>
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <TextBlock Text="{DynamicResource Str.Nav.NoFolders}" Classes="caption"
                         IsVisible="{Binding !HasFolders}" Margin="10,0,0,4" />

              <Grid ColumnDefinitions="*,Auto" Margin="10,20,8,8">
                <TextBlock Text="{DynamicResource Str.Nav.Section.Tags}" Classes="section" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Tags.Count}" Classes="number"
                           VerticalAlignment="Center" />
              </Grid>

              <ItemsControl ItemsSource="{Binding Tags}" HorizontalAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TagTreeItemViewModel">
                    <Button Classes="tagRow" Tag="{Binding}" Click="Tag_Click"
                            Theme="{StaticResource SidebarRowButton}"
                            ToolTip.Tip="{Binding Path}">
                      <Border Classes="rowFill">
                        <Grid ColumnDefinitions="Auto,*" Margin="{Binding Indent}">
                          <controls:StrokeIcon Data="{StaticResource Icon.Hash}" Width="14" Height="14" Thickness="1.6"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                                               VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,0,0"
                                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{DynamicResource Str.Nav.NoTags}" Classes="caption"
                         IsVisible="{Binding !HasTags}" Margin="10,0,0,4" />
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="18,0,12,0">
            <TextBlock Text="{Binding StatusText}" Classes="caption"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Classes="icon" Width="28" Height="28"
                    Command="{Binding RefreshAllCommand}" ToolTip.Tip="{DynamicResource Str.Nav.RefreshAllTip}">
              <controls:StrokeIcon Data="{StaticResource Icon.Refresh}" Width="14" Height="14" Thickness="1.5" />
            </Button>
          </Grid>
        </Grid>

        <!-- 画廊，内容从顶部悬浮药丸下方穿过。 -->
        <Grid Grid.Column="1" ClipToBounds="True">
          <Panel>
            <!-- 三个视图单独一层，切换时的 ZIndex 只在它们内部生效，
                 顶部渐隐、标题与药丸始终盖在上面。 -->
            <Panel x:Name="ViewHost">

              <controls:WaterfallGallery x:Name="Gallery"
                                         Items="{Binding Items}"
                                         TileWidth="{Binding ThumbnailSize}"
                                         UniformTiles="{Binding IsSemanticResult}"
                                         LeftPadding="24" TopPadding="112" RightGutter="18" BottomPadding="110" />

              <controls:LightWallCanvas x:Name="Wall" CornerRadius="0"
                                        Items="{Binding Items}" />

              <controls:GalaxyCanvas x:Name="Galaxy" CornerRadius="0"
                                     Nodes="{Binding GalaxyNodes}"
                                     Clusters="{Binding GalaxyClusters}"
                                     HighlightedIds="{Binding HighlightedIds}" />
            </Panel>

            
            <!-- 顶部四段渐隐，压住滚动经过的亮图，保证标题、计数与搜索药丸清晰可读。 -->
            <Border VerticalAlignment="Top" Height="136" IsHitTestVisible="False">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Offset="0" Color="{DynamicResource Color.Veil.Top}" />
                  <GradientStop Offset="0.52" Color="{DynamicResource Color.Veil.Mid}" />
                  <GradientStop Offset="0.8" Color="{DynamicResource Color.Veil.Soft}" />
                  <GradientStop Offset="1" Color="{DynamicResource Color.Fade.Clear}" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>

            <!-- 顶部整条保留为窗口拖拽带；按钮与输入框由事件处理器过滤，不参与拖动。 -->
            <Border VerticalAlignment="Top" Height="60" Background="Transparent"
                    PointerPressed="TitleBar_PointerPressed" />

            <!-- 第一行左侧放搜索药丸，右侧大片留白同时承担窗口拖动区，并避开右上角窗口控制按钮。 -->
            <Grid VerticalAlignment="Top" Margin="24,14,152,0" ColumnDefinitions="Auto,*">
              <Border CornerRadius="19" BoxShadow="{DynamicResource Shadow.Pill}"
                      VerticalAlignment="Center" HorizontalAlignment="Left">
                <ExperimentalAcrylicBorder Height="38" CornerRadius="19" ClipToBounds="True"
                                           Material="{DynamicResource Material.Acrylic}">
                  <Border x:Name="SearchShell" Classes="VisionPill"
                          Background="{DynamicResource Brush.Pill.Fill}"
                          Padding="13,0,8,0">
                    <Grid ColumnDefinitions="Auto,*,Auto" Width="304">
                      <controls:StrokeIcon Data="{StaticResource Icon.Search}" Width="14" Height="14" Thickness="1.7"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                                           VerticalAlignment="Center" />
                      <TextBox x:Name="SearchBox" Grid.Column="1" Classes="search"
                               Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Watermark="{Binding SearchHint}"
                               Margin="8,0" VerticalAlignment="Center"
                               GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Border Classes="kbd" IsVisible="{Binding !HasSearchText}">
                          <TextBlock Text="Ctrl+K" Classes="micro" VerticalAlignment="Center" />
                        </Border>
                        <Button Classes="icon" Width="24" Height="24" CornerRadius="999" Click="RunSearch_Click"
                                IsVisible="{Binding HasSearchText}" ToolTip.Tip="{DynamicResource Str.Search.RunTip}">
                          <controls:StrokeIcon Data="{StaticResource Icon.Search}" Width="12" Height="12" Thickness="1.7"
                                               Foreground="{DynamicResource Brush.Accent.Bright}" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </ExperimentalAcrylicBorder>
              </Border>
            </Grid>

            <!-- 第二行放集合标题与排序药丸，中间空白同样支持拖动窗口。 -->
            <Grid VerticalAlignment="Top" Margin="24,60,24,0" Height="36"
                  ColumnDefinitions="*,Auto" Background="Transparent"
                  PointerPressed="TitleBar_PointerPressed">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding CollectionTitle}" Classes="display" VerticalAlignment="Center" />

                <Border Background="{DynamicResource Brush.Surface.Elevated}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                        CornerRadius="999" Padding="8,2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Items.Count}" FontSize="{DynamicResource FontSize.Caption}"
                             Foreground="{DynamicResource Brush.Text.Secondary}" />
                </Border>

                <Border IsVisible="{Binding ShowCollectionKind}"
                        Background="{DynamicResource Brush.Surface.Card}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                        CornerRadius="999" Padding="8,2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding CollectionKind}" FontSize="{DynamicResource FontSize.Micro}"
                             Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center" />
                </Border>

                <!-- 排序说明用于解释而非筛选，因此使用文字而非第二枚蓝色胶囊。 -->
                <StackPanel IsVisible="{Binding IsSemanticResult}" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center" Margin="2,0,2,0"
                            ToolTip.Tip="{DynamicResource Str.Search.SemanticOrderTip}">
                  <controls:StrokeIcon Data="{StaticResource Icon.Sparkle}" Width="10" Height="10" Thickness="1.8"
                                       Foreground="{DynamicResource Brush.Accent.Bright}"
                                       VerticalAlignment="Center" />
                  <TextBlock Text="{DynamicResource Str.Search.SemanticOrder}" FontSize="{DynamicResource FontSize.Caption}"
                             Foreground="{DynamicResource Brush.Accent.Bright}" VerticalAlignment="Center" />
                </StackPanel>

                <Border IsVisible="{Binding IsSearchActive}" Background="{DynamicResource Brush.Accent.Subtle}"
                        CornerRadius="999" Padding="8,2,4,2" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding SearchQueryLabel}" FontSize="{DynamicResource FontSize.Caption}"
                               Foreground="{DynamicResource Brush.Accent.Bright}" MaxWidth="180"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button Classes="icon" Width="18" Height="18" Click="ClearSearch_Click"
                            ToolTip.Tip="{DynamicResource Str.Search.ClearTip}">
                      <controls:StrokeIcon Data="{StaticResource Icon.Close}" Width="10" Height="10" Thickness="1.6"
                                           Foreground="{DynamicResource Brush.Accent.Bright}" />
                    </Button>
                  </StackPanel>
                </Border>

                <Border IsVisible="{Binding IsMultiSelection}" Background="{DynamicResource Brush.Surface.Card}"
                        CornerRadius="999" Padding="8,2,4,2" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding SelectionSummary}" FontSize="{DynamicResource FontSize.Caption}"
                               Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                    <Button Classes="icon" Width="18" Height="18" Click="ClearSelection_Click"
                            ToolTip.Tip="{DynamicResource Str.Selection.ClearTip}">
                      <controls:StrokeIcon Data="{StaticResource Icon.Close}" Width="10" Height="10" Thickness="1.6" />
                    </Button>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- 排序按钮铺满整枚药丸，让附着其上的 MenuFlyout 右缘与药丸外缘精确对齐，高光边单独叠在上层。 -->
              <Border x:Name="SortPill" Grid.Column="1" VerticalAlignment="Center"
                      CornerRadius="16" BoxShadow="{DynamicResource Shadow.Pill}"
                      IsVisible="{Binding !IsSemanticResult}">
                <ExperimentalAcrylicBorder Height="32" CornerRadius="16" ClipToBounds="True"
                                           Material="{DynamicResource Material.Acrylic}">
                  <Panel Background="Transparent">
                    <Border CornerRadius="999" Background="{DynamicResource Brush.Pill.Fill}" IsHitTestVisible="False" />
                    <Button x:Name="SortButton" Classes="tool" Height="32" Padding="12,0"
                            ToolTip.Tip="{DynamicResource Str.Sort.AdjustTip}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:StrokeIcon Data="{StaticResource Icon.Sort}" Width="13" Height="13"
                                             Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        <TextBlock Text="{Binding SortLabel}" FontSize="{DynamicResource FontSize.Control}"
                                   Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" />
                        <controls:StrokeIcon Data="{StaticResource Icon.ChevronDown}" Width="11" Height="11" Thickness="1.6"
                                             Foreground="{DynamicResource Brush.Text.Tertiary}" />
                      </StackPanel>
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight" VerticalOffset="6">
                          <MenuItem Header="{DynamicResource Str.Sort.Default}" ToggleType="Radio" GroupName="SortMode"
                                    IsChecked="{Binding IsSortDefault}" Click="SortDefault_Click" />
                          <MenuItem Header="{DynamicResource Str.Sort.Taken}" ToggleType="Radio" GroupName="SortMode"
                                    IsChecked="{Binding IsSortTaken}" Click="SortTaken_Click" />
                          <MenuItem Header="{DynamicResource Str.Sort.Name}" ToggleType="Radio" GroupName="SortMode"
                                    IsChecked="{Binding IsSortName}" Click="SortName_Click" />
                          <MenuItem Header="{DynamicResource Str.Sort.Rating}" ToggleType="Radio" GroupName="SortMode"
                                    IsChecked="{Binding IsSortRating}" Click="SortRating_Click" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                    <Border Classes="VisionPill" Background="Transparent" IsHitTestVisible="False" />
                  </Panel>
                </ExperimentalAcrylicBorder>
              </Border>
            </Grid>

            <!-- 星系视图左下角只放重置入口，避免说明文字遮挡星图。 -->
            <Border IsVisible="{Binding IsGalaxy}"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="24,0,0,20" CornerRadius="20"
                    BoxShadow="{DynamicResource Shadow.Float}" ZIndex="20">
              <ExperimentalAcrylicBorder ClipToBounds="True" Height="40" CornerRadius="20"
                                         Material="{DynamicResource Material.Acrylic}">
                <Border Classes="VisionPill" Background="{DynamicResource Brush.Pill.Fill}" Padding="4">
                  <Button Classes="tool" Height="30" Click="ResetGalaxy_Click"
                          ToolTip.Tip="{DynamicResource Str.Galaxy.ResetViewTip}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <controls:StrokeIcon Data="{StaticResource Icon.Refresh}" Width="12" Height="12" />
                      <TextBlock Text="{DynamicResource Str.Galaxy.ResetView}" FontSize="{DynamicResource FontSize.Control}" />
                    </StackPanel>
                  </Button>
                </Border>
              </ExperimentalAcrylicBorder>
            </Border>

            <StackPanel IsVisible="{Binding IsEmpty}" Spacing="12" Width="360"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border Width="52" Height="52" CornerRadius="14"
                      Background="{DynamicResource Brush.Surface.Elevated}"
                      HorizontalAlignment="Center">
                <controls:StrokeIcon Data="{StaticResource Icon.Inbox}" Width="24" Height="24" Thickness="1.6"
                                     Foreground="{DynamicResource Brush.Text.Tertiary}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{Binding EmptyTitle}" Classes="title" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding EmptyDescription}" Classes="caption" TextWrapping="Wrap"
                         TextAlignment="Center" LineHeight="18" />
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                          Margin="0,4,0,0">
                <Button Classes="primary" Click="AddFolder_Click" Content="{DynamicResource Str.Empty.ImportFolder}"
                        IsVisible="{Binding !IsSearchActive}" />
                <Button Classes="primary" Click="ClearSearch_Click" Content="{DynamicResource Str.Empty.ClearFilter}"
                        IsVisible="{Binding IsSearchActive}" />
                <Button Classes="ghost" Click="AddFolder_Click" Content="{DynamicResource Str.Empty.ImportFolder}"
                        IsVisible="{Binding IsSearchActive}" />
              </StackPanel>
              <TextBlock Text="{DynamicResource Str.Empty.SupportedFormats}" Classes="caption"
                         HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 底部渐隐，让悬浮的缩略图大小控件始终压在干净的底色上。 -->
            <Border VerticalAlignment="Bottom" Height="96" IsHitTestVisible="False">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Offset="0" Color="{DynamicResource Color.Fade.Clear}" />
                  <GradientStop Offset="1" Color="{DynamicResource Color.Fade.Opaque}" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>

            <!-- 导入进度浮在视图切换药丸上方，扫完自动收起。 -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,72"
                    CornerRadius="25" BoxShadow="{DynamicResource Shadow.Float}" ZIndex="19"
                    IsVisible="{Binding IsImporting}" IsHitTestVisible="False">
              <ExperimentalAcrylicBorder ClipToBounds="True" Height="50" CornerRadius="25"
                                         Material="{DynamicResource Material.Acrylic}">
                <Border Classes="VisionPill" Background="{DynamicResource Brush.Pill.Fill}" Padding="18,0">
                  <StackPanel Spacing="6" Width="220" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ImportText}" FontSize="{DynamicResource FontSize.Caption}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               HorizontalAlignment="Center" />
                    <ProgressBar Height="3" CornerRadius="2" Minimum="0" Maximum="1"
                                 Value="{Binding ImportFraction}"
                                 IsIndeterminate="{Binding IsImportIndeterminate}" />
                  </StackPanel>
                </Border>
              </ExperimentalAcrylicBorder>
            </Border>

            <!-- 底部中央灵动岛用于视图切换，任何视图下都与滑块共享同一条基线。 -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                    CornerRadius="20" BoxShadow="{DynamicResource Shadow.Float}" ZIndex="20">
              <ExperimentalAcrylicBorder ClipToBounds="True" Height="40" CornerRadius="20" Material="{DynamicResource Material.Acrylic}">
                <Border Classes="VisionPill" Background="{DynamicResource Brush.Pill.Fill}" Padding="4">
                  <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="segment" Classes.active="{Binding IsGrid}"
                            Command="{Binding ShowGridCommand}" Content="{DynamicResource Str.View.Gallery}"
                            ToolTip.Tip="{DynamicResource Str.View.GalleryTip}" />
                    <Button Classes="segment" Classes.active="{Binding IsLightWall}"
                            Command="{Binding ShowWallCommand}" Content="{DynamicResource Str.View.Wall}"
                            ToolTip.Tip="{DynamicResource Str.View.WallTip}" />
                    <Button Classes="segment" Classes.active="{Binding IsGalaxy}"
                            Command="{Binding ShowGalaxyCommand}" Content="{DynamicResource Str.View.Galaxy}"
                            ToolTip.Tip="{DynamicResource Str.View.GalaxyTip}" />
                  </StackPanel>
                </Border>
              </ExperimentalAcrylicBorder>
            </Border>

            <!-- 多选操作条压在视图切换药丸上方，只在多选时出现，避免遮挡浏览。 -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,70"
                    CornerRadius="20" BoxShadow="{DynamicResource Shadow.Float}" ZIndex="21"
                    IsVisible="{Binding ShowBatchBar}">
              <ExperimentalAcrylicBorder ClipToBounds="True" Height="40" CornerRadius="20"
                                         Material="{DynamicResource Material.Acrylic}">
                <Border Classes="VisionPill" Background="{DynamicResource Brush.Pill.Fill}"
                        Padding="10,0,4,0">
                  <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectionSummary}" FontSize="{DynamicResource FontSize.Caption}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="4,0,10,0" VerticalAlignment="Center" />
                    <Button Classes="tool" Click="CopyTo_Click"
                            ToolTip.Tip="{DynamicResource Str.Batch.CopyToTip}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:StrokeIcon Data="{StaticResource Icon.Copy}" Width="14" Height="14" />
                        <TextBlock Text="{DynamicResource Str.Batch.CopyTo}" FontSize="{DynamicResource FontSize.Control}" />
                      </StackPanel>
                    </Button>
                    <Button Classes="tool" Click="MoveTo_Click"
                            ToolTip.Tip="{DynamicResource Str.Batch.MoveToTip}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:StrokeIcon Data="{StaticResource Icon.MoveTo}" Width="14" Height="14" />
                        <TextBlock Text="{DynamicResource Str.Batch.MoveTo}" FontSize="{DynamicResource FontSize.Control}" />
                      </StackPanel>
                    </Button>
                    <Button Classes="tool danger" Click="DeleteSelection_Click"
                            ToolTip.Tip="{DynamicResource Str.Batch.DeleteTip}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:StrokeIcon Data="{StaticResource Icon.Trash}" Width="14" Height="14" />
                        <TextBlock Text="{DynamicResource Str.Common.Delete}" FontSize="{DynamicResource FontSize.Control}" />
                      </StackPanel>
                    </Button>
                    <Button Classes="icon" Width="28" Height="28" Click="ClearSelection_Click"
                            ToolTip.Tip="{DynamicResource Str.Selection.ClearEscTip}">
                      <controls:StrokeIcon Data="{StaticResource Icon.Close}" Width="12" Height="12"
                                           Thickness="1.6" />
                    </Button>
                  </StackPanel>
                </Border>
              </ExperimentalAcrylicBorder>
            </Border>

            <!-- 底部缩略图大小控件为独立悬浮药丸，移到左下角后与右下角的窗口控制对称。 -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,20"
                    CornerRadius="20" BoxShadow="{DynamicResource Shadow.Float}" ZIndex="20"
                    IsVisible="{Binding IsGrid}">
              <ExperimentalAcrylicBorder ClipToBounds="True" Height="40" CornerRadius="20" Material="{DynamicResource Material.Acrylic}">
                <Border Classes="VisionPill" Background="{DynamicResource Brush.Pill.Fill}" Padding="12,0,16,0">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <controls:StrokeIcon Data="{StaticResource Icon.Grid}" Width="12" Height="12"
                                         Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    <controls:GalleryZoomSlider Width="88" Height="16" Minimum="132" Maximum="340"
                                                Value="{Binding ThumbnailSize, Mode=TwoWay}"
                                                ToolTip.Tip="{DynamicResource Str.Toolbar.ThumbSizeTip}" />
                  </StackPanel>
                </Border>
              </ExperimentalAcrylicBorder>
            </Border>

            <!-- 工具栏沉到右下角，中间用细竖线区分图库操作与界面控制。 -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,20"
                    CornerRadius="20" BoxShadow="{DynamicResource Shadow.Float}" ZIndex="20">
              <ExperimentalAcrylicBorder ClipToBounds="True" Height="40" CornerRadius="20" Material="{DynamicResource Material.Acrylic}">
                <Border Classes="VisionPill" Background="{DynamicResource Brush.Pill.Fill}" Padding="4">
                  <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="tool" Classes.active="{Binding SemanticEnabled}" Width="30" Height="30"
                            Padding="0" Click="ToggleSemantic_Click"
                            ToolTip.Tip="{DynamicResource Str.Toolbar.SemanticTip}">
                      <controls:StrokeIcon Data="{StaticResource Icon.Sparkle}" Width="15" Height="15" />
                    </Button>
                    <Button Classes="tool" Width="30" Height="30" Padding="0" Click="AddFolder_Click"
                            ToolTip.Tip="{DynamicResource Str.Toolbar.ImportFolderTip}">
                      <controls:StrokeIcon Data="{StaticResource Icon.Plus}" Width="15" Height="15" />
                    </Button>
                    <Border Width="1" Height="16" Margin="4,0"
                            Background="{DynamicResource Brush.Border.Subtle}" VerticalAlignment="Center" />
                    <Button Classes="tool" Width="30" Height="30" Padding="0"
                            Command="{Binding ToggleAppearanceCommand}"
                            ToolTip.Tip="{DynamicResource Str.Toolbar.ToggleAppearanceTip}">
                      <Panel>
                        <controls:StrokeIcon Data="{StaticResource Icon.Sun}" Width="15" Height="15"
                                             IsVisible="{Binding !IsLightAppearance}" />
                        <controls:StrokeIcon Data="{StaticResource Icon.Moon}" Width="15" Height="15"
                                             IsVisible="{Binding IsLightAppearance}" />
                      </Panel>
                    </Button>
                    <Button Classes="tool" Width="30" Height="30" Padding="0"
                            Classes.active="{Binding IsInspectorOpen}"
                            Click="ToggleInspector_Click" ToolTip.Tip="{DynamicResource Str.Toolbar.ToggleInspectorTip}">
                      <controls:StrokeIcon Data="{StaticResource Icon.Panel}" Width="15" Height="15" />
                    </Button>
                    <Button Classes="tool" Width="30" Height="30" Padding="0"
                            Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{DynamicResource Str.Toolbar.SettingsTip}">
                      <controls:StrokeIcon Data="{StaticResource Icon.Settings}" Width="15" Height="15" />
                    </Button>
                  </StackPanel>
                </Border>
              </ExperimentalAcrylicBorder>
            </Border>
          </Panel>
        </Grid>

        <!-- 右侧检查器与概览栏，使用独立微雾表面与卡片分组，未选图时展示图库概览。 -->
        <Border Grid.Column="2" Width="312" Margin="0"
                IsVisible="{Binding IsInspectorOpen}"
                Background="{DynamicResource Brush.Surface.Inspector}"
                BorderBrush="{DynamicResource Brush.Panel.Separator}"
                BorderThickness="1,0,0,0">
          <Grid RowDefinitions="32,44,*,Auto">

            <!-- 顶部预留窗口控制条高度，空白部分可拖动窗口。 -->
            <Border Grid.Row="0" Background="Transparent" PointerPressed="TitleBar_PointerPressed" />

            <!-- 固定顶栏，收起按钮改用侧栏图标，避免与窗口关闭叉号上下重叠。 -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,0,0,1"
                    Background="Transparent" PointerPressed="TitleBar_PointerPressed">
              <Grid ColumnDefinitions="*,Auto" Margin="16,0,12,0">
                <TextBlock Text="{Binding InspectorHeaderTitle}" Classes="heading" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="icon" Width="28" Height="28"
                        CornerRadius="8"
                        Click="CloseInspector_Click" ToolTip.Tip="{DynamicResource Str.Inspector.CollapseTip}">
                  <controls:StrokeIcon Data="{StaticResource Icon.PanelClose}" Width="15" Height="15" Thickness="1.5"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                </Button>
              </Grid>
            </Border>

            <!-- 主体内容区。选中图片时展示卡片式检查器，未选图时展示图库概览。 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <Panel>

                <StackPanel Margin="14,14,14,16" Spacing="12" IsVisible="{Binding HasSelection}">

                  <!-- 完整画框预览，使用 Uniform 展示整幅构图不裁头，右下角叠格式徽章。 -->
                  <Border CornerRadius="14" BoxShadow="{DynamicResource Shadow.Menu}">
                    <Border Height="212" CornerRadius="14" ClipToBounds="True"
                            Background="{DynamicResource Brush.Surface.Card}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
                      <Panel>
                        <Image Source="{Binding PreviewBitmap}" Stretch="Uniform" Margin="4"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <Border IsVisible="{Binding HasSelectedExtension}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,8,8" CornerRadius="999" Padding="8,2"
                                Background="{DynamicResource Brush.Overlay.Button}"
                                BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1">
                          <TextBlock Text="{Binding SelectedExtension}" FontSize="{DynamicResource FontSize.Micro}"
                                     FontWeight="SemiBold" Foreground="White" />
                        </Border>
                      </Panel>
                    </Border>
                  </Border>

                  <!-- 文件名与快捷操作药丸。 -->
                  <StackPanel Spacing="10">
                    <StackPanel Spacing="3" Margin="2,0">
                      <TextBlock Text="{Binding SelectedItem.FileName}"
                                 FontSize="{DynamicResource FontSize.Title}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 TextWrapping="NoWrap" MaxLines="1"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding SelectedItem.FileName}" />
                      <TextBlock Text="{Binding SelectedMeta}" FontSize="{DynamicResource FontSize.Caption}"
                                 Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    </StackPanel>

                    <Border Height="36" Background="{DynamicResource Brush.Control.Well}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                            CornerRadius="11" ClipToBounds="True">
                      <Grid ColumnDefinitions="*,1,*,1,*">
                        <Button Classes="inspectorAction" Click="OpenSelected_Click"
                                ToolTip.Tip="{DynamicResource Str.Inspector.Action.OpenTip}">
                          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                            <controls:StrokeIcon Data="{StaticResource Icon.Eye}" Width="14" Height="14" Thickness="1.6" />
                            <TextBlock Text="{DynamicResource Str.Inspector.Action.Open}" />
                          </StackPanel>
                        </Button>
                        <Border Grid.Column="1" Width="1" Background="{DynamicResource Brush.Border.Subtle}" Margin="0,9" />
                        <Button Grid.Column="2" Classes="inspectorAction" Click="RevealSelected_Click"
                                ToolTip.Tip="{DynamicResource Str.Inspector.Action.RevealTip}">
                          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                            <controls:StrokeIcon Data="{StaticResource Icon.Folder}" Width="14" Height="14" Thickness="1.6" />
                            <TextBlock Text="{DynamicResource Str.Inspector.Action.Reveal}" />
                          </StackPanel>
                        </Button>
                        <Border Grid.Column="3" Width="1" Background="{DynamicResource Brush.Border.Subtle}" Margin="0,9" />
                        <Button Grid.Column="4" Classes="inspectorAction" Click="CopyPath_Click"
                                ToolTip.Tip="{DynamicResource Str.Inspector.Action.CopyPathTip}">
                          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                            <controls:StrokeIcon Data="{StaticResource Icon.Copy}" Width="14" Height="14" Thickness="1.6" />
                            <TextBlock Text="{DynamicResource Str.Inspector.Action.Copy}" />
                          </StackPanel>
                        </Button>
                      </Grid>
                    </Border>
                  </StackPanel>

                  <!-- 基础信息卡片。 -->
                  <Border Classes="inspectorCard">
                    <StackPanel Spacing="9">
                      <TextBlock Text="{DynamicResource Str.Inspector.Section.BasicInfo}" Classes="section" />
                      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="7" ColumnSpacing="12">
                        <TextBlock Text="{DynamicResource Str.Inspector.Field.Dimensions}" MinWidth="40" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedDimensions}"
                                   FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Text="{DynamicResource Str.Inspector.Field.Taken}" MinWidth="40" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"
                                   VerticalAlignment="Top" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDateText}"
                                   FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Text="{DynamicResource Str.Inspector.Field.Location}" MinWidth="40" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"
                                   VerticalAlignment="Top" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedLocation}"
                                   FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding SelectedLocation}" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <!-- 角色与作品卡片，支持行内编辑。 -->
                  <Border Classes="inspectorCard">
                    <StackPanel Spacing="9">
                      <TextBlock Text="{DynamicResource Str.Inspector.Section.CharacterSeries}" Classes="section" />

                      <!-- 角色展示态。 -->
                      <Grid IsVisible="{Binding !IsEditingCharacters}" ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="{DynamicResource Str.Inspector.Field.Character}" MinWidth="36" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"
                                   VerticalAlignment="Center" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding SelectedCharacters}"
                                      Margin="10,0,0,0"
                                      IsVisible="{Binding HasSelectedCharacters}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Tag">
                              <Border Background="{DynamicResource Brush.Accent.Subtle}" BorderBrush="{DynamicResource Brush.Accent.Glow}"
                                      BorderThickness="1" CornerRadius="999"
                                      Padding="9,3" Margin="0,0,6,4">
                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSize.Caption}"
                                           FontWeight="Medium" Foreground="{DynamicResource Brush.Accent.Bright}"
                                           MaxWidth="140" TextTrimming="CharacterEllipsis" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Str.Inspector.Unrecognized}" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Disabled}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   IsVisible="{Binding !HasSelectedCharacters}" />
                        <Button Grid.Column="2" Classes="icon" Width="24" Height="24" VerticalAlignment="Center"
                                Command="{Binding BeginEditCharactersCommand}" ToolTip.Tip="{DynamicResource Str.Inspector.EditCharactersTip}">
                          <controls:StrokeIcon Data="{StaticResource Icon.Edit}" Width="11" Height="11"
                                               Thickness="1.6" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        </Button>
                      </Grid>

                      <!-- 角色编辑态，多个角色用逗号分隔，清空即清除。 -->
                      <Grid IsVisible="{Binding IsEditingCharacters}" ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Text="{DynamicResource Str.Inspector.Field.Character}" MinWidth="36" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="CharacterEditBox" Grid.Column="1" Classes="field" MinHeight="28"
                                 Margin="10,0,0,0"
                                 Text="{Binding CharacterDraft, Mode=TwoWay}"
                                 Watermark="{DynamicResource Str.Inspector.EditCharactersWatermark}" />
                        <Button Grid.Column="2" Classes="icon" Width="24" Height="24" Margin="6,0,0,0"
                                Command="{Binding CancelCharactersCommand}" ToolTip.Tip="{DynamicResource Str.Common.Cancel}">
                          <controls:StrokeIcon Data="{StaticResource Icon.Close}" Width="10" Height="10"
                                               Thickness="1.6" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        </Button>
                        <Button Grid.Column="3" Classes="icon" Width="24" Height="24" Margin="2,0,0,0"
                                Command="{Binding CommitCharactersCommand}" ToolTip.Tip="{DynamicResource Str.Common.Confirm}">
                          <controls:StrokeIcon Data="{StaticResource Icon.Check}" Width="12" Height="12"
                                               Thickness="1.8"
                                               Foreground="{DynamicResource Brush.Accent.Bright}" />
                        </Button>
                      </Grid>

                      <Border Height="1" Background="{DynamicResource Brush.Hairline}" />

                      <!-- 作品展示态。 -->
                      <Grid IsVisible="{Binding !IsEditingSeries}" ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="{DynamicResource Str.Inspector.Field.Series}" MinWidth="36" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0"
                                Background="{DynamicResource Brush.Series.Chip}" BorderBrush="{DynamicResource Brush.Series.ChipEdge}" BorderThickness="1"
                                CornerRadius="999" Padding="9,3"
                                IsVisible="{Binding HasSelectedSeries}">
                          <TextBlock Text="{Binding SelectedSeriesText}" FontSize="{DynamicResource FontSize.Caption}"
                                     Foreground="{DynamicResource Brush.Text.Primary}"
                                     MaxWidth="160" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Str.Inspector.Unrecognized}" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Disabled}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   IsVisible="{Binding !HasSelectedSeries}" />
                        <Button Grid.Column="2" Classes="icon" Width="24" Height="24" VerticalAlignment="Center"
                                Command="{Binding BeginEditSeriesCommand}" ToolTip.Tip="{DynamicResource Str.Inspector.EditSeriesTip}">
                          <controls:StrokeIcon Data="{StaticResource Icon.Edit}" Width="11" Height="11"
                                               Thickness="1.6" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        </Button>
                      </Grid>

                      <!-- 作品编辑态。 -->
                      <Grid IsVisible="{Binding IsEditingSeries}" ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Text="{DynamicResource Str.Inspector.Field.Series}" MinWidth="36" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="SeriesEditBox" Grid.Column="1" Classes="field" MinHeight="28"
                                 Margin="10,0,0,0"
                                 Text="{Binding SeriesDraft, Mode=TwoWay}"
                                 Watermark="{DynamicResource Str.Inspector.EditSeriesWatermark}" />
                        <Button Grid.Column="2" Classes="icon" Width="24" Height="24" Margin="6,0,0,0"
                                Command="{Binding CancelSeriesCommand}" ToolTip.Tip="{DynamicResource Str.Common.Cancel}">
                          <controls:StrokeIcon Data="{StaticResource Icon.Close}" Width="10" Height="10"
                                               Thickness="1.6" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        </Button>
                        <Button Grid.Column="3" Classes="icon" Width="24" Height="24" Margin="2,0,0,0"
                                Command="{Binding CommitSeriesCommand}" ToolTip.Tip="{DynamicResource Str.Common.Confirm}">
                          <controls:StrokeIcon Data="{StaticResource Icon.Check}" Width="12" Height="12"
                                               Thickness="1.8"
                                               Foreground="{DynamicResource Brush.Accent.Bright}" />
                        </Button>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <!-- 标签卡片，AI 识别结果与手动标签同处展示。 -->
                  <Border Classes="inspectorCard">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="{DynamicResource Str.Inspector.Section.Tags}" Classes="section" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Background="{DynamicResource Brush.Surface.Elevated}"
                                CornerRadius="999" Padding="7,1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding SelectedTags.Count}" Classes="number" VerticalAlignment="Center" />
                        </Border>
                      </Grid>

                      <!-- 未安装模型时给出明确出路；识别结果会直接写入下面的标签。 -->
                      <Border IsVisible="{Binding !IsTagModelReady}"
                              Background="{DynamicResource Brush.Control.Well}"
                              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                              CornerRadius="10" Padding="10,9">
                        <StackPanel Spacing="8">
                          <TextBlock Text="{DynamicResource Str.Inspector.TagModelPrompt}"
                                     Classes="caption" TextWrapping="Wrap" LineHeight="{DynamicResource LineHeight.Caption}" />
                          <Button Classes="ghost" HorizontalAlignment="Stretch" MinHeight="28"
                                  IsEnabled="{Binding !IsTagModelDownloading}"
                                  Command="{Binding DownloadTagModelCommand}">
                            <TextBlock Text="{DynamicResource Str.Inspector.DownloadModel}" FontSize="{DynamicResource FontSize.Control}"
                                       HorizontalAlignment="Center" />
                          </Button>
                          <Button Classes="ghost" HorizontalAlignment="Stretch" MinHeight="28"
                                  IsVisible="{Binding IsTagModelDownloading}"
                                  Click="CancelTagModelDownload_Click">
                            <TextBlock Text="{DynamicResource Str.Inspector.CancelDownload}" FontSize="{DynamicResource FontSize.Control}"
                                       HorizontalAlignment="Center" />
                          </Button>
                        </StackPanel>
                      </Border>

                      <Border IsVisible="{Binding IsMultiSelection}"
                              Background="{DynamicResource Brush.Accent.Subtle}"
                              CornerRadius="10" Padding="10,8">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding SelectionSummary}" FontSize="{DynamicResource FontSize.Caption}"
                                     Foreground="{DynamicResource Brush.Accent.Bright}" />
                          <TextBlock Text="{DynamicResource Str.Inspector.MultiSelectionTagNote}" Classes="caption" />
                        </StackPanel>
                      </Border>

                      <ItemsControl ItemsSource="{Binding SelectedTags}"
                                    IsVisible="{Binding !IsMultiSelection}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="models:Tag">
                            <Border Background="{DynamicResource Brush.Surface.Elevated}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                                    CornerRadius="999" MinHeight="26" Padding="9,2,6,2" Margin="0,0,6,6">
                              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="#" FontSize="{DynamicResource FontSize.Micro}" Foreground="{DynamicResource Brush.Text.Tertiary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.Text.Primary}"
                                           VerticalAlignment="Center" />
                                <Button Classes="icon" Width="18" Height="18" Margin="1,0,0,0"
                                        Click="RemoveTag_Click" Tag="{Binding}" ToolTip.Tip="{DynamicResource Str.Inspector.RemoveTagTip}">
                                  <controls:StrokeIcon Data="{StaticResource Icon.Close}" Width="9" Height="9"
                                                       Thickness="1.6" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                </Button>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- 未选择图片时展示当前图库概览、本地 AI 状态与快捷操作，避免右侧大面积空白。 -->
                <StackPanel IsVisible="{Binding !HasSelection}" Margin="14,14,14,20" Spacing="12">

                  <Border Classes="inspectorCard">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding CollectionTitle}" Classes="title"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="{DynamicResource Brush.Surface.Elevated}"
                                CornerRadius="999" Padding="8,2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding CollectionKind}" FontSize="{DynamicResource FontSize.Micro}"
                                     Foreground="{DynamicResource Brush.Text.Tertiary}" />
                        </Border>
                      </Grid>

                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding CurrentCollectionCount}"
                                   FontFamily="{DynamicResource Font.Display}"
                                   FontSize="{DynamicResource FontSize.PageTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Text="{Binding CurrentCollectionCountUnit}" Classes="caption" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                      </StackPanel>

                      <Grid ColumnDefinitions="*,8,*">
                        <Border Grid.Column="0" Background="{DynamicResource Brush.Control.Well}"
                                CornerRadius="9" Padding="10,8">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding FolderCount}" Classes="title" />
                            <TextBlock Text="{DynamicResource Str.Inspector.Overview.Folders}" Classes="caption" />
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource Brush.Control.Well}"
                                CornerRadius="9" Padding="10,8">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding TagCount}" Classes="title" />
                            <TextBlock Text="{DynamicResource Str.Inspector.Overview.Tags}" Classes="caption" />
                          </StackPanel>
                        </Border>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border Classes="inspectorCard">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Str.Inspector.Overview.LocalAi}" Classes="section" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="tool" Height="24" Padding="8,0"
                                Command="{Binding OpenAiSettingsCommand}" ToolTip.Tip="{DynamicResource Str.Inspector.Overview.ManageAiTip}">
                          <TextBlock Text="{DynamicResource Str.Inspector.Overview.Manage}" FontSize="{DynamicResource FontSize.Micro}"
                                     Foreground="{DynamicResource Brush.Accent.Bright}" />
                        </Button>
                      </Grid>

                      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                        <Border Width="7" Height="7" CornerRadius="999" VerticalAlignment="Center"
                                Background="{DynamicResource Brush.State.Success}"
                                IsVisible="{Binding IsTagModelReady}" />
                        <Border Width="7" Height="7" CornerRadius="999" VerticalAlignment="Center"
                                Background="{DynamicResource Brush.Text.Disabled}"
                                IsVisible="{Binding !IsTagModelReady}" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Text="{DynamicResource Str.Inspector.Overview.AutoTagging}" FontSize="{DynamicResource FontSize.Caption}"
                                     FontWeight="Medium" Foreground="{DynamicResource Brush.Text.Primary}" />
                          <TextBlock Text="{Binding TagModelStatus}" Classes="caption"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Border Grid.Row="1" Width="7" Height="7" CornerRadius="999" VerticalAlignment="Center"
                                Background="{DynamicResource Brush.State.Success}"
                                IsVisible="{Binding IsModelReady}" />
                        <Border Grid.Row="1" Width="7" Height="7" CornerRadius="999" VerticalAlignment="Center"
                                Background="{DynamicResource Brush.Text.Disabled}"
                                IsVisible="{Binding !IsModelReady}" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="1">
                          <TextBlock Text="{DynamicResource Str.Inspector.Overview.SemanticSearch}" FontSize="{DynamicResource FontSize.Caption}"
                                     FontWeight="Medium" Foreground="{DynamicResource Brush.Text.Primary}" />
                          <TextBlock Text="{Binding SemanticStatus}" Classes="caption"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border Classes="inspectorCard">
                    <StackPanel Spacing="9">
                      <TextBlock Text="{DynamicResource Str.Inspector.Overview.Shortcuts}" Classes="section" />
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock Text="{DynamicResource Str.Inspector.Shortcut.ViewDetails}" Classes="caption" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Classes="kbd">
                          <TextBlock Text="{DynamicResource Str.Inspector.Shortcut.Click}" Classes="micro" />
                        </Border>

                        <TextBlock Grid.Row="1" Text="{DynamicResource Str.Inspector.Shortcut.OpenViewer}" Classes="caption" VerticalAlignment="Center" />
                        <Border Grid.Row="1" Grid.Column="1" Classes="kbd">
                          <TextBlock Text="{DynamicResource Str.Inspector.Shortcut.DoubleClick}" Classes="micro" />
                        </Border>

                        <TextBlock Grid.Row="2" Text="{DynamicResource Str.Inspector.Shortcut.MultiSelect}" Classes="caption" VerticalAlignment="Center" />
                        <Border Grid.Row="2" Grid.Column="1" Classes="kbd">
                          <TextBlock Text="{DynamicResource Str.Inspector.Shortcut.CtrlClick}" Classes="micro" />
                        </Border>

                        <TextBlock Grid.Row="3" Text="{DynamicResource Str.Inspector.Shortcut.QuickSearch}" Classes="caption" VerticalAlignment="Center" />
                        <Border Grid.Row="3" Grid.Column="1" Classes="kbd">
                          <TextBlock Text="Ctrl+K" Classes="micro" />
                        </Border>
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Panel>
            </ScrollViewer>

            <!-- 固定底部标签输入。 -->
            <Border Grid.Row="3" Padding="14,10,14,14"
                    BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,1,0,0"
                    IsVisible="{Binding HasSelection}">
              <Border Height="38" Background="{DynamicResource Brush.Control.Well}"
                      BorderBrush="{DynamicResource Brush.Border.Subtle}"
                      BorderThickness="1" CornerRadius="999" Padding="12,0,4,0">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Classes="search" Text="{Binding NewTag, Mode=TwoWay}"
                           Watermark="{DynamicResource Str.Inspector.AddTagWatermark}"
                           VerticalAlignment="Center">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding AddTagCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                  <Button Grid.Column="1" Classes="icon" Width="28" Height="28"
                          VerticalAlignment="Center"
                          CornerRadius="999" Background="{DynamicResource Brush.Accent.Subtle}"
                          Command="{Binding AddTagCommand}" ToolTip.Tip="{DynamicResource Str.Inspector.AddTagTip}">
                    <controls:StrokeIcon Data="{StaticResource Icon.Plus}" Width="12" Height="12"
                                         Foreground="{DynamicResource Brush.Accent.Bright}" />
                  </Button>
                </Grid>
              </Border>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <views:SettingsView x:Name="SettingsPage" IsVisible="{Binding IsSettingsOpen}" />

    <!-- 窗口控制固定在右上角，压在内容之上，任何视图下都能直接点到。 -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
      <Button Classes="win" Click="Minimize_Click" Focusable="False" ToolTip.Tip="{DynamicResource Str.Common.Minimize}">
        <controls:StrokeIcon Data="{StaticResource Icon.WinMinimize}" Width="12" Height="12" Thickness="1.5" />
      </Button>
      <Button x:Name="MaxRestoreButton" Classes="win"
              Click="MaximizeRestore_Click" Focusable="False" ToolTip.Tip="{DynamicResource Str.Common.Maximize}">
        <Panel>
          <controls:StrokeIcon x:Name="MaximizeIcon" Data="{StaticResource Icon.WinMaximize}"
                               Width="12" Height="12" Thickness="1.5" />
          <controls:StrokeIcon x:Name="RestoreIcon" Data="{StaticResource Icon.WinRestore}"
                               Width="12" Height="12" Thickness="1.5" IsVisible="False" />
        </Panel>
      </Button>
      <Button Classes="win close" Click="Close_Click" Focusable="False" ToolTip.Tip="{DynamicResource Str.Common.Close}">
        <controls:StrokeIcon Data="{StaticResource Icon.WinClose}" Width="12" Height="12" Thickness="1.5" />
      </Button>
    </StackPanel>
  </Grid>
</Window>
