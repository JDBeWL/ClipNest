<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ClipNest.App.Controls"
             xmlns:theme="using:ClipNest.App.Theme"
             x:Class="ClipNest.App.App">
  <Application.Resources>
    <ResourceDictionary>
      <!--
        使用单一系统字体族名而非复合字体链，避免 Avalonia 跳过本地化中文字体名。
        缺字兜底统一由 Program.cs 的 FontFallbacks 提供，运行时再按语言与设置覆盖。
      -->
      <FontFamily x:Key="Font.UI">Microsoft YaHei UI</FontFamily>
      <FontFamily x:Key="Font.Display">Microsoft YaHei UI</FontFamily>

      <!-- 字号与行高按角色分层，随全局字号档位动态替换。 -->
      <x:Double x:Key="FontSize.PageTitle">22</x:Double>
      <x:Double x:Key="FontSize.Display">19</x:Double>
      <x:Double x:Key="FontSize.InspectorTitle">16</x:Double>
      <x:Double x:Key="FontSize.Heading">15</x:Double>
      <x:Double x:Key="FontSize.Title">14</x:Double>
      <x:Double x:Key="FontSize.Body">13</x:Double>
      <x:Double x:Key="FontSize.Nav">13</x:Double>
      <x:Double x:Key="FontSize.Tag">12.5</x:Double>
      <x:Double x:Key="FontSize.Control">12.5</x:Double>
      <x:Double x:Key="FontSize.Caption">12</x:Double>
      <x:Double x:Key="FontSize.Micro">11</x:Double>
      <x:Double x:Key="LineHeight.Body">20</x:Double>
      <x:Double x:Key="LineHeight.Caption">18</x:Double>

      <!-- 子菜单与父菜单边缘对齐；Fluent 默认 -4 会压住父菜单的右侧内边距。 -->
      <x:Double x:Key="MenuFlyoutSubItemPopupHorizontalOffset">4</x:Double>
      <!-- 取消 Fluent 菜单滚动区自带的上下外边距，避免与 MenuFlyoutPresenter 内边距叠加。 -->
      <Thickness x:Key="MenuFlyoutScrollerMargin">0</Thickness>


      <!-- 两套主题各自持有完整画刷；切换变体时 Avalonia 会整体替换。 -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
        <!-- 表面色。 -->
        <SolidColorBrush x:Key="Brush.Surface.Window" Color="{x:Static theme:AppPalette.SurfaceWindow}" />
        <SolidColorBrush x:Key="Brush.Surface.Content" Color="{x:Static theme:AppPalette.SurfaceContent}" />
        <!-- 整窗统一玻璃底，侧栏、画廊与详情共享同一层，不被顶栏与分割线切开。 -->
        <SolidColorBrush x:Key="Brush.Surface.Shell" Color="{x:Static theme:AppPalette.SurfaceShell}" />
        <SolidColorBrush x:Key="Brush.Surface.Glass" Color="{x:Static theme:AppPalette.SurfaceGlass}" />
        <SolidColorBrush x:Key="Brush.Chrome" Color="{x:Static theme:AppPalette.SurfaceNavigation}" />
        <SolidColorBrush x:Key="Brush.Surface.Inspector" Color="{x:Static theme:AppPalette.SurfaceInspector}" />
        <SolidColorBrush x:Key="Brush.Surface.Elevated" Color="{x:Static theme:AppPalette.SurfaceElevated}" />
        <SolidColorBrush x:Key="Brush.Surface.Card" Color="{x:Static theme:AppPalette.SurfaceCard}" />
        <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{x:Static theme:AppPalette.SurfaceHover}" />
        <SolidColorBrush x:Key="Brush.Surface.Active" Color="{x:Static theme:AppPalette.SurfaceActive}" />
        <SolidColorBrush x:Key="Brush.Surface.Ornament" Color="{x:Static theme:AppPalette.SurfaceOrnament}" />
        <SolidColorBrush x:Key="Brush.Surface.Popup" Color="{x:Static theme:AppPalette.SurfacePopup}" />

        <!-- 分隔与控件槽位。 -->
        <SolidColorBrush x:Key="Brush.Hairline" Color="{x:Static theme:AppPalette.BorderSubtle}" />
        <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{x:Static theme:AppPalette.BorderSubtle}" />
        <SolidColorBrush x:Key="Brush.Border.Strong" Color="{x:Static theme:AppPalette.BorderStrong}" />
        <SolidColorBrush x:Key="Brush.Control.Well" Color="{x:Static theme:AppPalette.ControlWell}" />
        <SolidColorBrush x:Key="Brush.Control.Thumb" Color="{x:Static theme:AppPalette.ControlThumb}" />
        <SolidColorBrush x:Key="Brush.Scroll.Thumb" Color="{x:Static theme:AppPalette.ScrollThumb}" />
        <SolidColorBrush x:Key="Brush.Scroll.ThumbHover" Color="{x:Static theme:AppPalette.ScrollThumbHover}" />

        <!-- 文字色。 -->
        <SolidColorBrush x:Key="Brush.Text.Primary" Color="{x:Static theme:AppPalette.TextPrimary}" />
        <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{x:Static theme:AppPalette.TextSecondary}" />
        <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{x:Static theme:AppPalette.TextTertiary}" />
        <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{x:Static theme:AppPalette.TextDisabled}" />
        <SolidColorBrush x:Key="Brush.Text.Inverse" Color="{x:Static theme:AppPalette.TextInverse}" />

        <!-- 强调色。 -->
        <SolidColorBrush x:Key="Brush.Accent.Base" Color="{x:Static theme:AppPalette.Accent}" />
        <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{x:Static theme:AppPalette.AccentHover}" />
        <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{x:Static theme:AppPalette.AccentPressed}" />
        <SolidColorBrush x:Key="Brush.Accent.Bright" Color="{x:Static theme:AppPalette.AccentBright}" />
        <SolidColorBrush x:Key="Brush.Accent.On" Color="{x:Static theme:AppPalette.AccentOn}" />
        <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="{x:Static theme:AppPalette.AccentSubtle}" />
        <SolidColorBrush x:Key="Brush.Accent.Glow" Color="{x:Static theme:AppPalette.AccentGlow}" />

        <!-- 开关控件强调色随主题字典切换，保持与主强调色一致。 -->
        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{x:Static theme:AppPalette.Accent}" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{x:Static theme:AppPalette.AccentHover}" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{x:Static theme:AppPalette.AccentPressed}" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />

        <!-- 语义色。 -->
        <SolidColorBrush x:Key="Brush.State.Success" Color="{x:Static theme:AppPalette.Success}" />
        <SolidColorBrush x:Key="Brush.State.SuccessSubtle" Color="{x:Static theme:AppPalette.SuccessSubtle}" />
        <SolidColorBrush x:Key="Brush.State.Warning" Color="{x:Static theme:AppPalette.Warning}" />
        <SolidColorBrush x:Key="Brush.State.WarningSubtle" Color="{x:Static theme:AppPalette.WarningSubtle}" />
        <SolidColorBrush x:Key="Brush.State.Danger" Color="{x:Static theme:AppPalette.Danger}" />
        <SolidColorBrush x:Key="Brush.State.DangerSubtle" Color="{x:Static theme:AppPalette.DangerSubtle}" />

        <!-- 叠加层。 -->
        <SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="{x:Static theme:AppPalette.Scrim}" />
        <SolidColorBrush x:Key="Brush.Overlay.Ambient" Color="{x:Static theme:AppPalette.AmbientTint}" />
        <SolidColorBrush x:Key="Brush.Overlay.Button" Color="{x:Static theme:AppPalette.OverlayButton}" />
        <SolidColorBrush x:Key="Brush.Overlay.Selection" Color="{x:Static theme:AppPalette.SelectionFill}" />

        <LinearGradientBrush x:Key="Brush.Brand" StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="{x:Static theme:AppPalette.BrandStart}" />
          <GradientStop Offset="1" Color="{x:Static theme:AppPalette.BrandEnd}" />
        </LinearGradientBrush>

          <!-- 渐隐与亚克力材质，XAML 里无法直接引用画刷的颜色由此提供。 -->
          <Color x:Key="Color.Fade.Clear">#00111216</Color>
          <Color x:Key="Color.Fade.Opaque">#B8111216</Color>
          <Color x:Key="Color.Veil.Top">#F2111216</Color>
          <Color x:Key="Color.Veil.Mid">#D9111216</Color>
          <Color x:Key="Color.Veil.Soft">#59111216</Color>
          <Color x:Key="Color.Acrylic.Tint">#1E1E24</Color>
          <Color x:Key="Color.Acrylic.Fallback">#CC1C1C22</Color>

          <!-- 阴影。浅色界面的投影要轻得多，否则形成一圈脏边。 -->
          <BoxShadows x:Key="Shadow.Pill">0 8 24 0 #38000000</BoxShadows>
          <BoxShadows x:Key="Shadow.Float">0 16 36 0 #59000000</BoxShadows>
          <BoxShadows x:Key="Shadow.Stage">0 14 34 0 #47000000</BoxShadows>
          <BoxShadows x:Key="Shadow.Menu">0 8 20 0 #40000000</BoxShadows>
          <BoxShadows x:Key="Shadow.Popup">inset 0 1 0 0 #1AFFFFFF, 0 10 28 0 #66000000</BoxShadows>

          <!-- 亚克力胶囊的内衬与镜面边。深色下是白高光，浅色下必须是淡暗边才可见。 -->
          <!-- 亚克力材质整体随主题替换。浅色下必须提高不透明度，
               否则 Digger 取到的桌面壁纸会让侧栏变成一片脏灰。 -->
          <ExperimentalAcrylicMaterial x:Key="Material.Acrylic" BackgroundSource="Digger"
                                       TintColor="#1E1E24" TintOpacity="0.65"
                                       MaterialOpacity="0.45" FallbackColor="#CC1C1C22" />

          <SolidColorBrush x:Key="Brush.Pill.Fill" Color="#D415161B" />
          <LinearGradientBrush x:Key="Brush.Pill.Edge" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0.0" Color="#47FFFFFF" />
            <GradientStop Offset="0.35" Color="#17FFFFFF" />
            <GradientStop Offset="0.7" Color="#0CFFFFFF" />
            <GradientStop Offset="1.0" Color="#26FFFFFF" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="Brush.Glass.Edge" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0.0" Color="#55FFFFFF" />
            <GradientStop Offset="0.35" Color="#18FFFFFF" />
            <GradientStop Offset="0.7" Color="#08FFFFFF" />
            <GradientStop Offset="1.0" Color="#28FFFFFF" />
          </LinearGradientBrush>

          <!-- 作品系列胶囊。与角色胶囊用色相区分，浅色下同样要压淡。 -->
          <!-- 详情栏左侧的渐隐发丝缝。深色下是白，浅色下必须是暗色才可见。 -->
          <LinearGradientBrush x:Key="Brush.Panel.Separator" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#00FFFFFF" />
            <GradientStop Offset="0.16" Color="#12FFFFFF" />
            <GradientStop Offset="0.84" Color="#12FFFFFF" />
            <GradientStop Offset="1" Color="#00FFFFFF" />
          </LinearGradientBrush>

          <!-- 图片舞台上的翻页钮。深色下是暗玻璃，浅色下必须是亮玻璃。 -->
          <SolidColorBrush x:Key="Brush.Nav.Fill" Color="#B3141418" />
          <SolidColorBrush x:Key="Brush.Nav.Edge" Color="#24FFFFFF" />

          <SolidColorBrush x:Key="Brush.Series.Chip" Color="#1F8E8CF0" />
          <SolidColorBrush x:Key="Brush.Series.ChipEdge" Color="#338E8CF0" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
        <!-- 表面色。 -->
        <SolidColorBrush x:Key="Brush.Surface.Window" Color="{x:Static theme:AppPaletteLight.SurfaceWindow}" />
        <SolidColorBrush x:Key="Brush.Surface.Content" Color="{x:Static theme:AppPaletteLight.SurfaceContent}" />
        <!-- 整窗统一玻璃底，侧栏、画廊与详情共享同一层，不被顶栏与分割线切开。 -->
        <SolidColorBrush x:Key="Brush.Surface.Shell" Color="{x:Static theme:AppPaletteLight.SurfaceShell}" />
        <SolidColorBrush x:Key="Brush.Surface.Glass" Color="{x:Static theme:AppPaletteLight.SurfaceGlass}" />
        <SolidColorBrush x:Key="Brush.Chrome" Color="{x:Static theme:AppPaletteLight.SurfaceNavigation}" />
        <SolidColorBrush x:Key="Brush.Surface.Inspector" Color="{x:Static theme:AppPaletteLight.SurfaceInspector}" />
        <SolidColorBrush x:Key="Brush.Surface.Elevated" Color="{x:Static theme:AppPaletteLight.SurfaceElevated}" />
        <SolidColorBrush x:Key="Brush.Surface.Card" Color="{x:Static theme:AppPaletteLight.SurfaceCard}" />
        <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{x:Static theme:AppPaletteLight.SurfaceHover}" />
        <SolidColorBrush x:Key="Brush.Surface.Active" Color="{x:Static theme:AppPaletteLight.SurfaceActive}" />
        <SolidColorBrush x:Key="Brush.Surface.Ornament" Color="{x:Static theme:AppPaletteLight.SurfaceOrnament}" />
        <SolidColorBrush x:Key="Brush.Surface.Popup" Color="{x:Static theme:AppPaletteLight.SurfacePopup}" />

        <!-- 分隔与控件槽位。 -->
        <SolidColorBrush x:Key="Brush.Hairline" Color="{x:Static theme:AppPaletteLight.BorderSubtle}" />
        <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{x:Static theme:AppPaletteLight.BorderSubtle}" />
        <SolidColorBrush x:Key="Brush.Border.Strong" Color="{x:Static theme:AppPaletteLight.BorderStrong}" />
        <SolidColorBrush x:Key="Brush.Control.Well" Color="{x:Static theme:AppPaletteLight.ControlWell}" />
        <SolidColorBrush x:Key="Brush.Control.Thumb" Color="{x:Static theme:AppPaletteLight.ControlThumb}" />
        <SolidColorBrush x:Key="Brush.Scroll.Thumb" Color="{x:Static theme:AppPaletteLight.ScrollThumb}" />
        <SolidColorBrush x:Key="Brush.Scroll.ThumbHover" Color="{x:Static theme:AppPaletteLight.ScrollThumbHover}" />

        <!-- 文字色。 -->
        <SolidColorBrush x:Key="Brush.Text.Primary" Color="{x:Static theme:AppPaletteLight.TextPrimary}" />
        <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{x:Static theme:AppPaletteLight.TextSecondary}" />
        <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{x:Static theme:AppPaletteLight.TextTertiary}" />
        <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{x:Static theme:AppPaletteLight.TextDisabled}" />
        <SolidColorBrush x:Key="Brush.Text.Inverse" Color="{x:Static theme:AppPaletteLight.TextInverse}" />

        <!-- 强调色。 -->
        <SolidColorBrush x:Key="Brush.Accent.Base" Color="{x:Static theme:AppPaletteLight.Accent}" />
        <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{x:Static theme:AppPaletteLight.AccentHover}" />
        <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{x:Static theme:AppPaletteLight.AccentPressed}" />
        <SolidColorBrush x:Key="Brush.Accent.Bright" Color="{x:Static theme:AppPaletteLight.AccentBright}" />
        <SolidColorBrush x:Key="Brush.Accent.On" Color="{x:Static theme:AppPaletteLight.AccentOn}" />
        <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="{x:Static theme:AppPaletteLight.AccentSubtle}" />
        <SolidColorBrush x:Key="Brush.Accent.Glow" Color="{x:Static theme:AppPaletteLight.AccentGlow}" />

        <!-- 开关控件强调色随主题字典切换，保持与主强调色一致。 -->
        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{x:Static theme:AppPaletteLight.Accent}" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{x:Static theme:AppPaletteLight.AccentHover}" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{x:Static theme:AppPaletteLight.AccentPressed}" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />

        <!-- 语义色。 -->
        <SolidColorBrush x:Key="Brush.State.Success" Color="{x:Static theme:AppPaletteLight.Success}" />
        <SolidColorBrush x:Key="Brush.State.SuccessSubtle" Color="{x:Static theme:AppPaletteLight.SuccessSubtle}" />
        <SolidColorBrush x:Key="Brush.State.Warning" Color="{x:Static theme:AppPaletteLight.Warning}" />
        <SolidColorBrush x:Key="Brush.State.WarningSubtle" Color="{x:Static theme:AppPaletteLight.WarningSubtle}" />
        <SolidColorBrush x:Key="Brush.State.Danger" Color="{x:Static theme:AppPaletteLight.Danger}" />
        <SolidColorBrush x:Key="Brush.State.DangerSubtle" Color="{x:Static theme:AppPaletteLight.DangerSubtle}" />

        <!-- 叠加层。 -->
        <SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="{x:Static theme:AppPaletteLight.Scrim}" />
        <SolidColorBrush x:Key="Brush.Overlay.Ambient" Color="{x:Static theme:AppPaletteLight.AmbientTint}" />
        <SolidColorBrush x:Key="Brush.Overlay.Button" Color="{x:Static theme:AppPaletteLight.OverlayButton}" />
        <SolidColorBrush x:Key="Brush.Overlay.Selection" Color="{x:Static theme:AppPaletteLight.SelectionFill}" />

        <LinearGradientBrush x:Key="Brush.Brand" StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="{x:Static theme:AppPaletteLight.BrandStart}" />
          <GradientStop Offset="1" Color="{x:Static theme:AppPaletteLight.BrandEnd}" />
        </LinearGradientBrush>

          <!-- 渐隐与亚克力材质，XAML 里无法直接引用画刷的颜色由此提供。 -->
          <Color x:Key="Color.Fade.Clear">#00F6F7FA</Color>
          <Color x:Key="Color.Fade.Opaque">#B8F6F7FA</Color>
          <Color x:Key="Color.Veil.Top">#F5F6F7FA</Color>
          <Color x:Key="Color.Veil.Mid">#D9F6F7FA</Color>
          <Color x:Key="Color.Veil.Soft">#59F6F7FA</Color>
          <Color x:Key="Color.Acrylic.Tint">#F7F7FA</Color>
          <Color x:Key="Color.Acrylic.Fallback">#CCEFEFF2</Color>

          <!-- 阴影。浅色界面的投影要轻得多，否则形成一圈脏边。 -->
          <BoxShadows x:Key="Shadow.Pill">0 4 14 0 #1A000000</BoxShadows>
          <BoxShadows x:Key="Shadow.Float">0 10 24 0 #24000000</BoxShadows>
          <BoxShadows x:Key="Shadow.Stage">0 8 20 0 #1F000000</BoxShadows>
          <BoxShadows x:Key="Shadow.Menu">0 6 16 0 #1A000000</BoxShadows>
          <BoxShadows x:Key="Shadow.Popup">inset 0 1 0 0 #33FFFFFF, 0 8 22 0 #26000000</BoxShadows>

          <!-- 亚克力胶囊的内衬与镜面边。深色下是白高光，浅色下必须是淡暗边才可见。 -->
          <!-- 亚克力材质整体随主题替换。浅色下必须提高不透明度，
               否则 Digger 取到的桌面壁纸会让侧栏变成一片脏灰。 -->
          <ExperimentalAcrylicMaterial x:Key="Material.Acrylic" BackgroundSource="Digger"
                                       TintColor="#F7F7FA" TintOpacity="0.92"
                                       MaterialOpacity="0.86" FallbackColor="#CCEFEFF2" />

          <SolidColorBrush x:Key="Brush.Pill.Fill" Color="#E0F7F7FA" />
          <LinearGradientBrush x:Key="Brush.Pill.Edge" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0.0" Color="#26FFFFFF" />
            <GradientStop Offset="0.35" Color="#0A000000" />
            <GradientStop Offset="0.7" Color="#0A000000" />
            <GradientStop Offset="1.0" Color="#1A000000" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="Brush.Glass.Edge" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0.0" Color="#59FFFFFF" />
            <GradientStop Offset="0.35" Color="#10000000" />
            <GradientStop Offset="0.7" Color="#08000000" />
            <GradientStop Offset="1.0" Color="#1F000000" />
          </LinearGradientBrush>

          <!-- 作品系列胶囊。与角色胶囊用色相区分，浅色下同样要压淡。 -->
          <!-- 详情栏左侧的渐隐发丝缝。深色下是白，浅色下必须是暗色才可见。 -->
          <LinearGradientBrush x:Key="Brush.Panel.Separator" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#00000000" />
            <GradientStop Offset="0.16" Color="#14000000" />
            <GradientStop Offset="0.84" Color="#14000000" />
            <GradientStop Offset="1" Color="#00000000" />
          </LinearGradientBrush>

          <!-- 图片舞台上的翻页钮。深色下是暗玻璃，浅色下必须是亮玻璃。 -->
          <SolidColorBrush x:Key="Brush.Nav.Fill" Color="#E6F7F7FA" />
          <SolidColorBrush x:Key="Brush.Nav.Edge" Color="#29000000" />

          <SolidColorBrush x:Key="Brush.Series.Chip" Color="#1A5E5CE6" />
          <SolidColorBrush x:Key="Brush.Series.ChipEdge" Color="#295E5CE6" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- 侧栏行控件用最小模板。状态色完全交给下面的样式，Fluent 模板自带的
           悬停与按下底色不会再把应用色板盖掉。 -->
      <ControlTheme x:Key="SidebarRowButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="FolderItemTheme" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- 形状与阴影只在这里定义。容器 14、内边距 4，同心圆角为 10。 -->
      <CornerRadius x:Key="Radius.Panel">14</CornerRadius>
      <CornerRadius x:Key="Radius.Card">10</CornerRadius>
      <CornerRadius x:Key="Radius.Control">8</CornerRadius>
      <CornerRadius x:Key="Radius.Segment">6</CornerRadius>


      <!-- 图标，24×24 描边网格，线宽由 StrokeIcon.Thickness 控制。 -->
      <StreamGeometry x:Key="Icon.Photo">M4,7.5 A3.5,3.5 0 0 1 7.5,4 H16.5 A3.5,3.5 0 0 1 20,7.5 V16.5 A3.5,3.5 0 0 1 16.5,20 H7.5 A3.5,3.5 0 0 1 4,16.5 Z M4.7,17.5 L9.2,12.4 L12.6,15.9 L15.2,13.4 L19.3,17.5</StreamGeometry>
      <StreamGeometry x:Key="Icon.Folder">M3.5,7.9 A3,3 0 0 1 6.5,4.9 H9.3 A2.2,2.2 0 0 1 11,5.6 L12.3,7.3 H17.5 A3,3 0 0 1 20.5,10.3 V16.2 A3,3 0 0 1 17.5,19.2 H6.5 A3,3 0 0 1 3.5,16.2 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Search">M10.5,4 A6.5,6.5 0 1 0 10.5,17 A6.5,6.5 0 1 0 10.5,4 M15.2,15.2 L20,20</StreamGeometry>
      <StreamGeometry x:Key="Icon.Sparkle">M12,3.4 L13.8,9.2 L19.6,11 L13.8,12.8 L12,18.6 L10.2,12.8 L4.4,11 L10.2,9.2 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Sort">M4,6.5 H20 M4,12 H14.5 M4,17.5 H9.5</StreamGeometry>
      <StreamGeometry x:Key="Icon.Panel">M3.5,7.5 A4,4 0 0 1 7.5,3.5 H16.5 A4,4 0 0 1 20.5,7.5 V16.5 A4,4 0 0 1 16.5,20.5 H7.5 A4,4 0 0 1 3.5,16.5 Z M15,3.5 V20.5</StreamGeometry>
      <StreamGeometry x:Key="Icon.PanelClose">M3.5,7.5 A4,4 0 0 1 7.5,3.5 H16.5 A4,4 0 0 1 20.5,7.5 V16.5 A4,4 0 0 1 16.5,20.5 H7.5 A4,4 0 0 1 3.5,16.5 Z M15.5,3.5 V20.5 M8.8,9.2 L11.8,12 L8.8,14.8</StreamGeometry>
      <StreamGeometry x:Key="Icon.Grid">M4,4 H9.6 V9.6 H4 Z M14.4,4 H20 V9.6 H14.4 Z M4,14.4 H9.6 V20 H4 Z M14.4,14.4 H20 V20 H14.4 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Edit">M4.8,19.2 L5.4,15.2 L15.7,4.9 A2.1,2.1 0 0 1 18.7,7.9 L8.4,18.2 Z M13.8,6.8 L17.2,10.2</StreamGeometry>
      <StreamGeometry x:Key="Icon.Check">M5,12.7 L9.5,17.2 L19,6.9</StreamGeometry>
      <StreamGeometry x:Key="Icon.Plus">M12,5 V19 M5,12 H19</StreamGeometry>
      <!-- 顺时针刷新。四分之三圆弧加收尾处的直角箭头，缺口落在右上，避免箭头与圆弧粘连。 -->
      <StreamGeometry x:Key="Icon.Refresh">M21,12 A9,9 0 1 1 12,3 C14.5,3 16.9,3.95 18.74,5.74 L21,8 M21,3.2 V8 H16.2</StreamGeometry>
      <StreamGeometry x:Key="Icon.ChevronDown">M7.5,10 L12,14.5 L16.5,10</StreamGeometry>
      <StreamGeometry x:Key="Icon.ChevronLeft">M14.5,6.5 L9,12 L14.5,17.5</StreamGeometry>
      <StreamGeometry x:Key="Icon.ChevronRight">M9.5,6.5 L15,12 L9.5,17.5</StreamGeometry>
      <!-- 叉号画到 14/24 的跨度。小尺寸下描边抗锯齿不会把图形糊成一团，视觉重心仍在网格中心。 -->
      <StreamGeometry x:Key="Icon.Close">M5,5 L19,19 M19,5 L5,19</StreamGeometry>
      <StreamGeometry x:Key="Icon.Eye">M2.6,12 C5.3,7.5 8.6,5.6 12,5.6 C15.4,5.6 18.7,7.5 21.4,12 C18.7,16.5 15.4,18.4 12,18.4 C8.6,18.4 5.3,16.5 2.6,12 Z M12,9.2 A2.8,2.8 0 1 0 12,14.8 A2.8,2.8 0 1 0 12,9.2</StreamGeometry>
      <StreamGeometry x:Key="Icon.Copy">M11.8,9.4 H17.6 A2.4,2.4 0 0 1 20,11.8 V19.4 A2.4,2.4 0 0 1 17.6,21.8 H11.8 A2.4,2.4 0 0 1 9.4,19.4 V11.8 A2.4,2.4 0 0 1 11.8,9.4 Z M4.4,14.6 V6.4 A2,2 0 0 1 6.4,4.4 H14.6</StreamGeometry>
      <StreamGeometry x:Key="Icon.MoveTo">M3.5,7.9 A3,3 0 0 1 6.5,4.9 H9.3 A2.2,2.2 0 0 1 11,5.6 L12.3,7.3 H17.5 A3,3 0 0 1 20.5,10.3 V16.2 A3,3 0 0 1 17.5,19.2 H6.5 A3,3 0 0 1 3.5,16.2 Z M8.4,12.7 H15 M12.5,10 L15.2,12.7 L12.5,15.4</StreamGeometry>
      <StreamGeometry x:Key="Icon.File">M6.5,4.5 H13.4 L18,9.1 V19.5 H6.5 Z M13.4,4.5 V9.1 H18</StreamGeometry>
      <StreamGeometry x:Key="Icon.Trash">M4.5,7 H19.5 M9.5,6.6 V5.2 A1.2,1.2 0 0 1 10.7,4 H13.3 A1.2,1.2 0 0 1 14.5,5.2 V6.6 M6.6,7 L7.5,19 A1.7,1.7 0 0 0 9.2,20.6 H14.8 A1.7,1.7 0 0 0 16.5,19 L17.4,7 M10.3,10.6 V16.8 M13.7,10.6 V16.8</StreamGeometry>
      <StreamGeometry x:Key="Icon.Inbox">M3.5,13.5 L6.2,5.6 A2,2 0 0 1 8.1,4.2 H15.9 A2,2 0 0 1 17.8,5.6 L20.5,13.5 V17.5 A2.5,2.5 0 0 1 18,20 H6 A2.5,2.5 0 0 1 3.5,17.5 Z M3.5,13.5 H8.5 L9.5,15.6 H14.5 L15.5,13.5 H20.5</StreamGeometry>
      <StreamGeometry x:Key="Icon.Warning">M12,4 L21,19.5 H3 Z M12,10 V14.4 M12,16.9 V17.2</StreamGeometry>
      <StreamGeometry x:Key="Icon.WinMinimize">M5,12 H19</StreamGeometry>
      <StreamGeometry x:Key="Icon.WinMaximize">M5.5,5.5 H18.5 V18.5 H5.5 Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.WinRestore">M8.5,8.5 H18.5 V18.5 H8.5 Z M5.5,15.5 V5.5 H15.5</StreamGeometry>
      <StreamGeometry x:Key="Icon.WinClose">M6.5,6.5 L17.5,17.5 M17.5,6.5 L6.5,17.5</StreamGeometry>
      <StreamGeometry x:Key="Icon.Settings">M4,8 H20 M4,16 H20 M9,5.5 V10.5 M15,13.5 V18.5</StreamGeometry>
      <StreamGeometry x:Key="Icon.Sun">M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M12,2.6 V5 M12,19 V21.4 M2.6,12 H5 M19,12 H21.4 M5.4,5.4 L7.1,7.1 M16.9,16.9 L18.6,18.6 M18.6,5.4 L16.9,7.1 M7.1,16.9 L5.4,18.6</StreamGeometry>
    <StreamGeometry x:Key="Icon.Moon">M20,14.2 A8.6,8.6 0 0 1 9.8,4 A8.8,8.8 0 1 0 20,14.2 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Hash">M9.5,4.5 L7.8,19.5 M16.2,4.5 L14.5,19.5 M4.5,9.2 H19.8 M4.2,14.8 H19.5</StreamGeometry>

      <!--
        滚动条统一成 4px 悬浮细条，与画廊自绘滚动条的视觉粗细一致。
        Thumb 必须自带固定轨道宽度与 MinHeight，否则 Track 算出的可用长度为 0，滑块不会绘制。
      -->
      <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="MinHeight" Value="8" />

        <Style Selector="^:vertical">
          <Setter Property="Width" Value="8" />
          <Setter Property="MinWidth" Value="8" />
          <Setter Property="MaxWidth" Value="8" />
          <Setter Property="Template">
            <ControlTemplate>
              <Border Background="Transparent" Padding="0,4">
                <Track Name="PART_Track"
                       Minimum="{TemplateBinding Minimum}"
                       Maximum="{TemplateBinding Maximum}"
                       Value="{TemplateBinding Value, Mode=TwoWay}"
                       ViewportSize="{TemplateBinding ViewportSize}"
                       Orientation="Vertical"
                       IsDirectionReversed="True">
                  <Track.Thumb>
                    <Thumb Name="PART_Thumb" Width="8" MinHeight="28" Padding="2,0"
                           Background="{DynamicResource Brush.Scroll.Thumb}">
                      <Thumb.Template>
                        <ControlTemplate>
                          <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <Border Background="{TemplateBinding Background}" CornerRadius="999" />
                          </Border>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Border>
            </ControlTemplate>
          </Setter>
        </Style>

        <Style Selector="^:vertical:pointerover /template/ Thumb#PART_Thumb">
          <Setter Property="Background" Value="{DynamicResource Brush.Scroll.ThumbHover}" />
          <Setter Property="Padding" Value="1.5,0" />
        </Style>

        <Style Selector="^:horizontal">
          <Setter Property="Height" Value="8" />
          <Setter Property="MinHeight" Value="8" />
          <Setter Property="MaxHeight" Value="8" />
          <Setter Property="Template">
            <ControlTemplate>
              <Border Background="Transparent" Padding="4,0">
                <Track Name="PART_Track"
                       Minimum="{TemplateBinding Minimum}"
                       Maximum="{TemplateBinding Maximum}"
                       Value="{TemplateBinding Value, Mode=TwoWay}"
                       ViewportSize="{TemplateBinding ViewportSize}"
                       Orientation="Horizontal">
                  <Track.Thumb>
                    <Thumb Name="PART_Thumb" Height="8" MinWidth="28" Padding="0,2"
                           Background="{DynamicResource Brush.Scroll.Thumb}">
                      <Thumb.Template>
                        <ControlTemplate>
                          <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <Border Background="{TemplateBinding Background}" CornerRadius="999" />
                          </Border>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Border>
            </ControlTemplate>
          </Setter>
        </Style>

        <Style Selector="^:horizontal:pointerover /template/ Thumb#PART_Thumb">
          <Setter Property="Background" Value="{DynamicResource Brush.Scroll.ThumbHover}" />
          <Setter Property="Padding" Value="0,1.5" />
        </Style>
      </ControlTheme>
      </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
      <FluentTheme />
      <StyleInclude Source="avares://ClipNest.App/Styles/VisionTheme.axaml" />

      <!-- 交互反馈使用 120ms 色彩过渡与统一的键盘焦点环。 -->
      <Style Selector="Button">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
          <BrushTransition Property="Foreground" Duration="0:0:0.12" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      </Style>
      <Style Selector="Button:focus-visible">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      </Style>
      <Style Selector="Button.primary:focus-visible">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent.Hover}" />
      </Style>

      <Style Selector="ToolTip">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Popup}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
      <Setter Property="Padding" Value="9,5" />
      </Style>

      <!-- 字号层级按角色命名，全部绑定动态资源以支持运行时切换字体与缩放。 -->
      <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
      </Style>
      <!-- 菜单与浮层挂在各自的弹出根上，不在窗口的可视树里，字体要单独下发。 -->
      <Style Selector="TemplatedControl">
      <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
      </Style>
      <Style Selector="TextBlock.display">
      <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Display}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      </Style>
      <Style Selector="TextBlock.heading">
      <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Heading}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      </Style>
      <Style Selector="TextBlock.title">
      <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Title}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      </Style>
      <Style Selector="TextBlock.body">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
      <Setter Property="LineHeight" Value="{DynamicResource LineHeight.Body}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      </Style>
      <Style Selector="TextBlock.meta">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
      <Setter Property="LineHeight" Value="{DynamicResource LineHeight.Caption}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      </Style>
      <Style Selector="TextBlock.callout">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
      <Setter Property="LineHeight" Value="{DynamicResource LineHeight.Caption}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      </Style>
      <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
      <Setter Property="LineHeight" Value="{DynamicResource LineHeight.Caption}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
      </Style>
      <Style Selector="TextBlock.micro">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Micro}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LetterSpacing" Value="0.6" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
      </Style>
      <Style Selector="TextBlock.number">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
      </Style>
      <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.4" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
      </Style>

      <!-- 图标按钮。 -->
      <Style Selector="Button.icon">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style Selector="Button.icon:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      </Style>
      <Style Selector="Button.icon:pressed">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Active}" />
      </Style>
      <!-- 文件夹行的移除按钮只在指针落到按钮本身时转为实心红，平时与其他图标同色。 -->
      <Style Selector="Button.icon.danger:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.State.Danger}" />
      <Setter Property="Foreground" Value="White" />
      </Style>
      <!--
        Fluent 模板把悬停底色与前景都画在 ContentPresenter 上，只设置 Button 自身会被模板内层的值覆盖。
        移除按钮的红色必须同时写到模板内层，图标才不会透出灰底或被主题换成深色。
      -->
      <Style Selector="Button.icon.danger /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      </Style>
      <Style Selector="Button.icon.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.State.Danger}" />
      <Setter Property="Foreground" Value="White" />
      </Style>
      <Style Selector="Button.icon.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.State.Danger}" />
      <Setter Property="Foreground" Value="White" />
      </Style>

      <!-- 顶栏工具按钮使用图标与文字，高度与搜索框对齐。 -->
      <Style Selector="Button.tool">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Control}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style Selector="Button.tool:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      </Style>
      <!-- 工具开关打开时使用中性底与强调色图标，既标出状态，又不与主操作争抢注意力。 -->
      <Style Selector="Button.tool.active">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Active}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Bright}" />
      </Style>
      <!-- 批量操作里的删除入口只在指针悬停时显示红底，平时与普通工具按钮同权重。 -->
      <Style Selector="Button.tool.danger">
      <Setter Property="Foreground" Value="{DynamicResource Brush.State.Danger}" />
      </Style>
      <Style Selector="Button.tool.danger:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.State.DangerSubtle}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.State.Danger}" />
      </Style>
      <Style Selector="Button.tool.danger /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.State.Danger}" />
      </Style>
      <Style Selector="Button.tool.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.State.DangerSubtle}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.State.Danger}" />
      </Style>
      <Style Selector="Button.tool.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.State.DangerSubtle}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.State.Danger}" />
      </Style>

      <!--
        窗口控制沿用 Windows 习惯，最小化、最大化与关闭固定在右上角。
        尺寸与系统标题栏一致，悬停时才浮出底色，关闭使用红色。
      -->
      <Style Selector="Button.win">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style Selector="Button.win:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Active}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      </Style>
      <Style Selector="Button.win.close:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.State.Danger}" />
      <Setter Property="Foreground" Value="White" />
      </Style>

      <!--
        默认按钮模板的悬停底色画在 ContentPresenter 上，会盖住 Button 自身的背景；
        窗口控制的悬停色必须同时写到模板内层，关闭才能显示红色。
      -->
      <Style Selector="Button.win /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      </Style>
      <Style Selector="Button.win:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Active}" />
      </Style>
      <Style Selector="Button.win.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.State.Danger}" />
      </Style>

      <!-- 分段控件。 -->
      <Style Selector="Button.segment">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Control}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style Selector="Button.segment:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      </Style>
      <Style Selector="Button.segment.active">
      <Setter Property="Background" Value="{DynamicResource Brush.Control.Thumb}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      </Style>

      <!-- 主要与次要按钮。 -->
      <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent.Base}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.On}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Control}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent.Hover}" />
      </Style>
      <Style Selector="Button.primary:pressed">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent.Pressed}" />
      </Style>

      <!-- 不可逆操作使用实心红按钮，只在确认对话框里出现。类名必须独占，
           不得复用 icon 或 tool 的 danger 类，否则会覆盖侧栏与批量条的小按钮。 -->
      <Style Selector="Button.destructive">
      <Setter Property="Background" Value="{DynamicResource Brush.State.Danger}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Control}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style Selector="Button.destructive:pointerover">
      <Setter Property="Opacity" Value="0.88" />
      </Style>
      <Style Selector="Button.destructive:pressed">
      <Setter Property="Opacity" Value="0.78" />
      </Style>
      <Style Selector="Button.destructive /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.State.Danger}" />
      <Setter Property="Foreground" Value="White" />
      </Style>
      <Style Selector="Button.destructive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.State.Danger}" />
      <Setter Property="Foreground" Value="White" />
      </Style>
      <Style Selector="Button.destructive:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.State.Danger}" />
      <Setter Property="Foreground" Value="White" />
      </Style>

      <Style Selector="Button.ghost">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Elevated}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Control}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style Selector="Button.ghost:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Active}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
      </Style>
      <!-- 次要破坏性操作平时保持克制，悬停时才转为柔和警示色。 -->
      <Style Selector="Button.ghost.danger">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      </Style>
      <Style Selector="Button.ghost.danger:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.State.DangerSubtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.State.Danger}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.State.Danger}" />
      </Style>
      <Style Selector="Button.ghost.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.State.DangerSubtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.State.Danger}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.State.Danger}" />
      </Style>
      <Style Selector="Button.ghost.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.State.DangerSubtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.State.Danger}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.State.Danger}" />
      </Style>

      <Style Selector="Button.chip">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Elevated}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
      </Style>
      <Style Selector="Button.chip:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Bright}" />
      </Style>

      <!-- 输入框。 -->
      <Style Selector="TextBox.field">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Control.Well}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Control}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent.Base}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent.Glow}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style Selector="TextBox.field:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Base}" />
      </Style>
      <Style Selector="TextBox.field /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      </Style>
      <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      </Style>

      <!-- 搜索框无边框，由外层胶囊承担视觉容器；不锁死行高，避免高行距字体被裁切。 -->
      <Style Selector="TextBox.search">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Control}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent.Base}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent.Glow}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="22" />
      </Style>
      <Style Selector="TextBox.search /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      </Style>
      <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      </Style>

      <Style Selector="ToggleButton.segment">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Control}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style Selector="ToggleButton.segment:checked">
      <Setter Property="Background" Value="{DynamicResource Brush.Control.Thumb}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      </Style>

      <!-- 下拉框与弹出项统一到圆角玻璃质感，避免露出 Fluent 默认直角白框。 -->
      <Style Selector="ComboBox">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Elevated}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,5,10,5" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Control}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style Selector="ComboBox:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Active}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
      </Style>
      <Style Selector="ComboBox:pressed /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Active}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Base}" />
      </Style>
      <Style Selector="ComboBox:dropdownopen /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Active}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Base}" />
      </Style>
      <Style Selector="ComboBox /template/ Border#PopupBorder">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Popup}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Popup}" />
      </Style>
      <Style Selector="ComboBoxItem">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Control}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      </Style>
      <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      </Style>
      <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      </Style>
      <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      </Style>

      <Style Selector="Border.kbd">
      <Setter Property="Background" Value="{DynamicResource Brush.Control.Well}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <Style Selector="ListBox.plain">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      </Style>

      <Style Selector="ProgressBar">
      <Setter Property="Background" Value="{DynamicResource Brush.Border.Subtle}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Base}" />
      <Setter Property="CornerRadius" Value="1" />
      </Style>

      <Style Selector="MenuFlyoutPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Popup}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="MinWidth" Value="136" />
      </Style>
      <Style Selector="MenuItem">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Control}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="CornerRadius" Value="7" />
      </Style>
      <Style Selector="MenuItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      </Style>
  </Application.Styles>
</Application>
